{
  "name": "dsh.nudge",
  "version": "0.1.0",
  "private": true,
  "description": "Nudge for DSH Desktop: point at anything in the right-sidebar browser, annotate it for the agent, or nudge its styles, text and attributes until it looks right.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "nudge",
    "browser",
    "annotation",
    "devtools"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.70.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test/client-smoke.mjs && node test/client-theme.test.mjs && node test/settings-page.test.mjs && node test/workspace-panel.test.mjs && node test/clip-annotations.test.mjs && node test/runtime-smoke.mjs && node test/source-sync.test.mjs && node test/workspace-domain.test.mjs && node test/host-integration.test.mjs && node test/workspace-e2e.test.mjs"
  }
}
